# 复制为 .env 后填写；或直接用系统环境变量（推荐后者，密钥不落盘）
#
# 必填：OpenCode Go 的 key。只从环境读取，代码不会把它写进日志或响应。
OPENCODE_GO_API_KEY=

# 监听端口
GATE_PORT=8787

# 车道（模型）顺序：必须是 deepseek- 前缀，否则拒绝启动
GATE_CHAIN=deepseek-flash,deepseek-v4.1-flash

# 上游（一般不用改）
# GATE_HOST=opencode.ai
# GATE_HOST_PORT=443
# GATE_HOST_SCHEME=https

# 协议级封禁：chat 协议没有可靠判据，默认封掉
GATE_BLOCK_PROTOS=chat

# 预检复用窗口（ms）。上游池切换频繁时调小，稳定时调大
# GATE_PRECHECK_TTL_MS=30000

# 完整变量清单见 docs/OPERATIONS-zh.md「四、环境变量」
