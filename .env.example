# 复制为 .env 后填写；或直接用系统环境变量（推荐后者，密钥不落盘）
#
# 必填：OpenCode Go 的 key。只从环境读取，代码不会把它写进日志或响应。
OPENCODE_GO_API_KEY=

# 监听端口
GATE_PORT=8787

# 车道（模型）顺序：必须是 deepseek- 前缀，否则拒绝启动
# 2026-10-27：deepseek-flash / deepseek-v4-flash 已被上游下线（410 ModelDeprecated），
# 现在只有 deepseek-v4.1-flash 可用。填旧名会让门控全量 503。
GATE_CHAIN=deepseek-v4.1-flash

# 上游（一般不用改）
# GATE_HOST=opencode.ai
# GATE_HOST_PORT=443
# GATE_HOST_SCHEME=https

# 协议级封禁（追加语义）。messages 已由代码无条件封禁，除非显式设 GATE_ALLOW_MESSAGES=1。
# 2026-10-27 实测：messages 侧混入非 UUID4 id 池 + Go 实现，判据无法保证官方，故默认拒绝。
GATE_BLOCK_PROTOS=chat

# 预检复用窗口（ms）。上游池切换频繁时调小，稳定时调大。默认 15000（15 秒）。
# 注意：必须 ≥ 后台保活周期（GATE_PROOF_REFRESH_MS，默认 25000）的合理下限，
# 否则 TTL 过期后落在空窗里的请求要同步跑一次探针（多付 1.5–4.7s）。
# GATE_PRECHECK_TTL_MS=15000

# 「无证据」预检重试（2026-11-07）：探针给 net/rate/timeout 时重试几次（默认 1）。
# 只对"没问到"重试，fail/format/drift 一次都不重试，判据强度不变。
# GATE_PRECHECK_NOEVID_RETRY=1

# 计费恒等式不成立时的处置：warn（只记软告警，默认）/ retry（升 hard 并重发）。
# 上游单价会在 1×/2× 之间整段切换，所以默认保持 warn。
# GATE_BILLING_POLICY=warn

# 完整变量清单见 docs/CONFIG.md「四、环境变量」

# 优雅停止（ocg restart/stop）等待在途请求收尾的上限（ms）。空闲时立即完成。
# GATE_DRAIN_MAX_MS=15000
